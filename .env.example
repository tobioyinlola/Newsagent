DATABASE_URL=postgresql+asyncpg://newsagent:newsagent@localhost:5432/newsagent
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
HEYGEN_API_KEY=
SYNTHESIA_API_KEY=
TRANSCRIPTION_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=Newsroom <no-reply@localhost>
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=newsagent
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
RENDERER_URL=http://localhost:4000
RENDERER_SHARED_SECRET=dev-secret
OPERATOR_EMAILS=ops@example.com
SENTRY_DSN=
REMOTION_LICENSE_KEY=
APP_BASE_URL=http://localhost:5173
ENVIRONMENT=local
USE_MOCKS=true
SECRET_KEY=                   # Fernet key; REQUIRED outside local. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
INTERVIEW_EXPIRY_DAYS=14
INTERVIEW_REMINDER_DAYS=2,5,9
RAW_TAKE_RETENTION_DAYS=90
TRANSCRIPTION_API_URL=https://api.openai.com/v1   # any OpenAI-compatible /audio/transcriptions endpoint
TRANSCRIPTION_MODEL=whisper-1
TRUST_PROXY_HEADERS=false     # true behind Railway so per-IP limits see real client IPs
CLAMD_HOST=                   # ClamAV; uploads are refused without it when USE_MOCKS=false
BILLING_WEBHOOK_SECRET=       # HMAC secret for payment webhooks; REQUIRED outside local (24+ chars)
BILLING_PROVIDER=mock         # real provider adapter is undecided
CREDIT_MARKUP=1               # customer credits charged per 1 USD of vendor cost
USD_PER_CREDIT=1              # revenue per credit, for margin reporting
LOW_BALANCE_THRESHOLD=5
RENDERER_ALLOWED_HOSTS=       # renderer only: comma list of hosts it may download from (e.g. your R2 host)
MAX_QUEUE=20                  # renderer only: waiting jobs before it answers 429
API_ORIGIN=                   # web build: where the browser may connect (CSP); STORAGE_ORIGIN likewise
OPERATOR_EMAILS=
QUEUE_BACKEND=inline
