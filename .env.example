DATABASE_URL=postgresql+asyncpg://newsagent:newsagent@localhost:5432/newsagent
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=ca98f45881f1ba5ee6ad7a44d64855e5   # look used when a project picks none: "CF News Desk Anchor - man (sample)", made from the news-desk photo. Find others with scripts/list_presenters.py
HEYGEN_FULLFRAME_AVATAR_IDS=294e7a4a0fc0e8bc6d4990e34f5365fc,ca98f45881f1ba5ee6ad7a44d64855e5:plain,56f77809cfb5befeec11d8820fef119f:plain   # looks whose video already contains the studio: requested as plain MP4 and shown full frame; `:plain` = no screens to cover (the man and the woman at the news desk)
HEYGEN_FEATURED_PRESENTERS=ca98f45881f1ba5ee6ad7a44d64855e5|Marcus, news desk|male;56f77809cfb5befeec11d8820fef119f|Elena, news desk|female;294e7a4a0fc0e8bc6d4990e34f5365fc|Studio anchor|female   # offered first in the presenter picker; pictures live in frontend/public/presenters/<id>.jpg
HEYGEN_WEBHOOK_SECRET=          # optional: enables POST /v1/webhooks/heygen (HMAC-SHA256 of the raw body); verify the scheme in HeyGen's docs first
HEYGEN_WEBHOOK_SIGNATURE_HEADER=signature
SYNTHESIA_API_KEY=
TRANSCRIPTION_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=Newsroom <no-reply@localhost>
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=newsagent
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
RENDERER_URL=http://localhost:4000
RENDERER_SHARED_SECRET=dev-secret
OPERATOR_EMAILS=ops@example.com
SENTRY_DSN=
REMOTION_LICENSE_KEY=
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174   # the separate back-office site; REQUIRED (and different from APP_BASE_URL) outside local
ENVIRONMENT=local
USE_MOCKS=true
SECRET_KEY=                   # Fernet key; REQUIRED outside local. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
INTERVIEW_EXPIRY_DAYS=14
INTERVIEW_REMINDER_DAYS=2,5,9
RAW_TAKE_RETENTION_DAYS=90
TRANSCRIPTION_API_URL=https://api.openai.com/v1   # any OpenAI-compatible /audio/transcriptions endpoint
TRANSCRIPTION_MODEL=whisper-1
TTS_API_KEY=                  # the AI interviewer's voice; empty = the browser speaks instead
TTS_API_URL=https://api.openai.com/v1   # any OpenAI-compatible /audio/speech endpoint
TTS_MODEL=tts-1
TTS_VOICE=alloy
TRUST_PROXY_HEADERS=false     # true behind Railway so per-IP limits see real client IPs
CLAMD_HOST=                   # ClamAV; uploads are refused without it when USE_MOCKS=false
BILLING_WEBHOOK_SECRET=       # HMAC secret for payment webhooks; REQUIRED outside local (24+ chars)
BILLING_PROVIDER=mock         # real provider adapter is undecided
CREDIT_MARKUP=1               # customer credits charged per 1 USD of vendor cost
USD_PER_CREDIT=1              # revenue per credit, for margin reporting
LOW_BALANCE_THRESHOLD=5
RENDERER_ALLOWED_HOSTS=       # renderer only: comma list of hosts it may download from (e.g. your R2 host)
MAX_QUEUE=20                  # renderer only: waiting jobs before it answers 429
API_ORIGIN=                   # web build: where the browser may connect (CSP); STORAGE_ORIGIN likewise
OPERATOR_EMAILS=
QUEUE_BACKEND=inline
