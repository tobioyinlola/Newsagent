{
  "name": "newsagent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests --exclude e2e --exclude e2e-real",
    "e2e": "playwright test",
    "e2e:real": "bash e2e-real/make-media.sh && playwright test -c playwright.real.config.ts",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen:api:check": "pnpm gen:api && git diff --exit-code src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "openapi-fetch": "^0.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.7.0",
    "jsdom": "^24.1.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
